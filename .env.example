# Never commit your actual .env file to source control.

# OpenRouter API key (https://openrouter.ai/keys)

OPENROUTER_API_KEY= # Paste Your API Key

# Optional: shown in OpenRouter's dashboard/rankings, not required
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=# Put Your Application Name (Used in OPENROUTER)

OPENROUTER_MAX_TOKENS=600
# SMTP settings for sending the email.
# For Gmail: use smtp.gmail.com, port 587, and an "App Password"
# (not your regular Gmail password) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=# Your Email: xxxx@gmail.com
SMTP_PASSWORD= #See The README.md --> #SMTP CONFIG 
